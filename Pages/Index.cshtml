@page
@model OnMe.Api.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@Model.Setting("seo_title", "OnMe | خلّها علينا — وكيلك الشخصي لإنجاز مهامك")</title>
  <meta name="description" content="@Model.Setting("seo_description", "عندك مهمة ما عندك وقت لها؟ أرسلها إلى OnMe، وخلّنا نراجع البحث والتواصل والتنسيق والمتابعة عنك.")" />
  <meta name="theme-color" content="#FAF9F6" />
  <meta property="og:title" content="OnMe | خلّها علينا" />
  <meta property="og:description" content="عندك مهمة؟ خلّها علينا. أرسل اللي تحتاجه ونبحث عن الطريقة المناسبة لتنفيذه." />
  <meta property="og:image" content="assets/logo.jpeg" />
  <link rel="icon" type="image/jpeg" href="assets/logo.jpeg" />
  <link rel="icon" type="image/png" sizes="192x192" href="assets/icon-192.png" />
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png" />
  <link rel="manifest" href="manifest.webmanifest" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="OnMe" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" asp-append-version="true" />
</head>
<body>
  <!-- ===== Navbar ===== -->
  <header class="nav" id="top">
    <div class="container nav-inner">
      <a class="brand" href="#top" aria-label="OnMe الرئيسية">
        <span class="brand-mark"><img src="assets/logo.jpeg" alt="شعار OnMe" /></span>
        <span class="brand-text"><b>On<i>Me</i></b> <em>خلّها علينا</em></span>
      </a>
      <a href="#lead-form" class="btn btn-primary btn-sm">خلّها علينا</a>
    </div>
  </header>

  <main>
    <!-- ===== Hero ===== -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <span class="eyebrow">وكيلك الشخصي للمهام</span>
          <h1>عندك مهمة؟<br /><span class="accent-line">خلّها علينا.</span></h1>
          <p class="lead">
            مو كل شيء يستحق من وقتك.<br />
            أرسل لنا اللي تحتاجه، ونبحث عن الطريقة المناسبة للبحث والتواصل
            والتنسيق والمتابعة حتى نوصلك للنتيجة الممكنة.
          </p>
          <div class="hero-meta">
            <span class="dot"></span>
            <span>رد خلال ساعات العمل · بدون التزام</span>
          </div>
        </div>
        <div class="hero-visual reveal">
          <div class="visual-card visual-video">
            <video id="heroVideo" class="hero-video" controls playsinline preload="metadata" poster="assets/logo.jpeg" aria-label="فيديو تعريفي OnMe"></video>
            <button id="heroPlay" class="video-play" aria-label="تشغيل الفيديو"><span>▶</span></button>
            <div class="visual-chip chip-1">
              <span class="chip-check">✓</span>
              <span>استلمنا مهمتك</span>
            </div>
            <div class="visual-chip chip-2">
              <span class="chip-dot"></span>
              <span>قيد التنسيق والمتابعة</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section class="section about">
      <div class="container narrow reveal">
        <h2>مو لازم تسوي كل شيء بنفسك.</h2>
        <p>
          عندك موضوع يحتاج بحثًا أو اتصالًا أو ترتيبًا أو متابعة؟
          اشرح لنا المطلوب، ونحن نراجع المهمة ونبحث عن الطريقة
          المناسبة لتنفيذ ما يمكننا توليه عنك.
        </p>
        <p class="standout">أنت تحدد النتيجة، ونحن نبحث عن الطريق إليها.</p>
      </div>
    </section>

    <!-- ===== Services ===== -->
    <section class="section" id="services">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-tag">خدمات مرنة حسب احتياجك</span>
          <h2>وش ممكن ننجز لك؟</h2>
          <p class="muted">لا نحصر OnMe في خدمات محددة. قل لنا وش تحتاج، ونشوف كيف نقدر نتولاها.</p>
        </div>
        <div class="spotlight reveal" id="svcSpot">
          <div class="spot-stage" id="spotStage">
            <article class="spot-card active">
              <div class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              </div>
              <h3>بحث ومقارنة</h3>
              <p>البحث عن منتج أو مورد أو خدمة أو معلومة، مع المقارنة والتنسيق عند الحاجة.</p>
            </article>
            <article class="spot-card">
              <div class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5z"/></svg>
              </div>
              <h3>تواصل وتنسيق</h3>
              <p>التواصل مع الجهات والأشخاص، طرح الاستفسارات وجمع المعلومات وترتيب الخطوات.</p>
            </article>
            <article class="spot-card">
              <div class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 8v4l3 2"/></svg>
              </div>
              <h3>متابعة وإنجاز</h3>
              <p>متابعة موضوع أو إجراء بدأته، وتنسيق المهام التي تحتاج وقتًا أو مراجعة مستمرة.</p>
            </article>
            <article class="spot-card">
              <div class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14 0 18M12 3c-3 3.5-3 14 0 18"/></svg>
              </div>
              <h3>مهام داخل السعودية أو خارجها</h3>
              <p>موضوع يحتاج من يتابع أو ينسق في مدينة أو دولة أخرى، حسب إمكانية التنفيذ.</p>
            </article>
          </div>
          <div class="spot-nav">
            <button class="spot-arrow" id="spotPrev" aria-label="الخدمة السابقة">→</button>
            <span class="spot-dots" id="spotDots" role="tablist" aria-label="التنقل بين الخدمات"></span>
            <button class="spot-arrow" id="spotNext" aria-label="الخدمة التالية">←</button>
          </div>
        </div>
        <p class="fine-note reveal">مهمتك لا تحتاج أن تكون موجودة هنا. فقط اشرح لنا ما تحتاجه.</p>
      </div>
    </section>

    <!-- ===== How ===== -->
    <section class="section section-alt" id="how">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-tag">بكل بساطة</span>
          <h2>ثلاث خطوات <span class="hl">فقط.</span></h2>
        </div>
        <ol class="steps">
          <li class="step reveal">
            <span class="step-thumb" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22 11 13 2 9Z"/></svg></span>
            <h3>أرسل طلبك</h3>
            <p class="sr-only">اكتب لنا المهمة بالطريقة التي تعرفها، حتى لو لم تكن متأكدًا من الخطوات.</p>
          </li>
          <li class="step reveal">
            <span class="step-thumb" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
            <h3>نراجع طلبك</h3>
            <p class="sr-only">نراجع التفاصيل، ونبحث ونتواصل وننسق حسب طبيعة الطلب وإمكانية تنفيذه.</p>
          </li>
          <li class="step reveal">
            <span class="step-thumb" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.8-5.4"/></svg></span>
            <h3>نتابع معك</h3>
            <p class="sr-only">نوضح لك الخطوات الممكنة ونبقيك على اطلاع حتى تصل المهمة إلى نتيجتها المتاحة.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ===== Examples ===== -->
    <section class="section">
      <div class="container">
        <div class="section-head reveal examples-head">
          <h2>أمثلة على مهام <span class="hl">ممكن ترسلها لنا</span></h2>
        </div>
        <div class="typewriter reveal" id="exampleTyper">
          <div class="tw-head">
            <span class="tw-avatar" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
            </span>
            <span class="tw-who"><b>عميل OnMe</b><small>يكتب الآن</small></span>
            <span class="tw-live" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <p class="tw-text" aria-hidden="true"><span id="twText"></span><span class="tw-caret" aria-hidden="true"></span></p>
          <span class="sr-only">أمثلة على مهام: أحتاج ألقى موردًا في دولة أخرى لمنتج معين. أريد أحدًا يتواصل مع عدة جهات ويجمع لي المعلومات. عندي موضوع يحتاج متابعة في مدينة أخرى. أحتاج البحث والمقارنة والترتيب قبل اتخاذ قرار.</span>
          <div class="tw-foot">
            <span class="tw-progress" id="twDots" aria-hidden="true"></span>
            <span class="tw-count" id="twCount">1 / 4</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Lead form ===== -->
    <section class="section section-alt" id="lead-form">
      <div class="container narrow">
        <div class="form-card reveal">
          <div id="form-view">
            <span class="section-tag">نبدأ معك من هنا</span>
            <h2 class="form-title">خلّها علينا.</h2>
            <p class="muted">اشرح لنا المهمة، والباقي نبدأ فيه معك.</p>
            <form id="leadForm" novalidate>
              <div class="form-row">
              <label class="field">
                <span>الاسم</span>
                <span class="control">
                  <input type="text" name="name" placeholder="اكتب اسمك" autocomplete="name" required />
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
                </span>
                <small class="err" data-err="name"></small>
              </label>
              <label class="field">
                <span>رقم الجوال</span>
                <span class="control">
                  <input type="tel" name="phone" placeholder="05XXXXXXXX" inputmode="numeric" autocomplete="tel" required />
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <small class="err" data-err="phone"></small>
              </label>
              </div>
              <label class="field">
                <span>وصف المهمة</span>
                <span class="control">
                  <textarea name="description" rows="4" placeholder="وش تحتاج؟ اشرح لنا المهمة بالتفصيل..." required></textarea>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                </span>
                <small class="err" data-err="description"></small>
              </label>
              <fieldset class="field">
                <legend>وين المهمة؟ <em>(اختياري)</em></legend>
                <div class="radios">
                  <label><input type="radio" name="location" value="inside_saudi" /> داخل السعودية</label>
                  <label><input type="radio" name="location" value="outside_saudi" /> خارج السعودية</label>
                  <label><input type="radio" name="location" value="unsure" /> غير متأكد</label>
                </div>
              </fieldset>
              <button type="submit" class="btn btn-primary btn-block" id="submitBtn">أرسل طلبي <span class="btn-arrow" aria-hidden="true">←</span></button>
              <p class="fine-note center">سيتم التواصل معك لمراجعة تفاصيل المهمة والخطوات الممكنة لتنفيذها.</p>
              <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
            </form>
          </div>
          <div id="success-view" hidden>
            <div class="success-check" aria-hidden="true">✓</div>
            <h2>وصلنا طلبك.</h2>
            <p class="muted">شكرًا لك. استلمنا تفاصيل المهمة، وسنتواصل معك لمراجعة المطلوب والخطوات التالية.</p>
            <p class="ref" id="leadRef"></p>
            <a href="#top" class="text-link">العودة إلى الصفحة الرئيسية ←</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section">
      <div class="container">
        <div class="faq reveal" id="faq">
          <h2 class="faq-title">أسئلة سريعة</h2>
          <div class="accordion">
            <details class="acc" open>
              <summary>هل تنفذون أي مهمة؟</summary>
              <p>كل مهمة تختلف. أرسل التفاصيل وسنراجع إمكانية تنفيذها والخطوات المناسبة لها.</p>
            </details>
            <details class="acc">
              <summary>هل الخدمة داخل السعودية فقط؟</summary>
              <p>يمكن أن تكون المهمة داخل السعودية أو خارجها، حسب طبيعة المهمة وإمكانية تنفيذها.</p>
            </details>
            <details class="acc">
              <summary>هل يجب أن أعرف طريقة تنفيذ المهمة؟</summary>
              <p>لا. اشرح النتيجة التي تريد الوصول إليها، وسنبحث عن الطريقة المناسبة لما يمكننا توليه.</p>
            </details>
            <details class="acc">
              <summary>كم تستغرق المهمة؟</summary>
              <p>تختلف المدة حسب طبيعة المهمة والجهات المطلوبة. نوضح الخطوات والمدة المتوقعة بعد مراجعة الطلب.</p>
            </details>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <strong>@Model.Setting("footer_text", "OnMe — خلّها علينا.")</strong>
        <span class="muted">وكيلك الشخصي لإنجاز مهامك</span>
      </div>
      <div class="footer-links">
        <a href="tel:@Model.Setting("phone", "0533851110")" dir="ltr">@Model.Setting("phone", "0533851110")</a>
        <span class="sep">·</span>
        <a href="#lead-form">أرسل طلبك</a>
      </div>
      <p class="copy">@Model.Setting("copyright", "© 2026 OnMe. All rights reserved.")</p>
      <p class="credit"><span class="credit-spark" aria-hidden="true">✦</span> تطوير وتصميم شركة <strong class="credit-brand" dir="ltr">onyxvs</strong> لحلول الأعمال المتقدمة</p>
    </div>
  </footer>

  <script src="app.js" asp-append-version="true"></script>
</body>
</html>
